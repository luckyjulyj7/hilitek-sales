{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/quanlybanhang", "destination": "/admin.html" },
    { "source": "/quanlybanhang/(.*)", "destination": "/admin.html" },
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/shop/(.*)", "destination": "/shop.html" },
    { "source": "/sitemap.xml", "destination": "/api/web/sitemap" },
    { "source": "/media/:path*", "destination": "/api/web/media?path=:path*" },
    { "source": "/san-pham/:slug", "destination": "/api/web/page?slug=:slug" },
    { "source": "/danh-muc", "destination": "/api/web/page" },
    { "source": "/may-choi-game-cam-tay", "destination": "/api/web/page?landing=handheld" },
    { "source": "/tin-tuc", "destination": "/api/web/page?landing=news" },
    { "source": "/trang/:slug", "destination": "/api/web/page?trang=:slug" },
    { "source": "/((?!api/).*)", "destination": "/shop.html" }
  ],
  "headers": [
    {
      "source": "/home/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/posters/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(logo-sm|zalo-sm|bo-cong-thuong|logo1|Logo2|og-image)\\.(png|jpg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ],
  "crons": [
    { "path": "/api/cron/backup", "schedule": "0 17 * * *" }
  ],
  "functions": {
    "api/web/ai-product-info.js": { "maxDuration": 60 }
  }
}
